# Copy to .env (npm run dev does this for you and fills in a database password).

# --- Server ---
PORT=3001
# Where the app opens; used in links sent by email (password reset).
APP_URL=http://localhost:5173
# Public HTTPS address of this server. Mercado Pago only sends payment webhooks to HTTPS.
# Leave empty in development: the app then polls Mercado Pago for payment status instead.
PUBLIC_URL=

# --- Database (PostgreSQL) ---
# LOCAL_DB=1 makes `npm run dev` create and start a private PostgreSQL cluster in .postgres/
# Set LOCAL_DB=0 to use any other PostgreSQL (Docker, Neon, Supabase, RDS...) via DATABASE_URL.
LOCAL_DB=1
DATABASE_URL=postgres://obra:change-me@127.0.0.1:5433/obra_agil

# --- SMS codes (Twilio Verify) ---
# Without these, codes are printed in the API terminal in development and SMS sign-in is off in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Email (SMTP, e.g. smtp://user:password@smtp.resend.com:587) ---
# Without it, password reset links are printed in the API terminal in development.
SMTP_URL=
MAIL_FROM="Obra Ágil <nao-responda@obraagil.com.br>"

# --- Mercado Pago (Pix + credit card in installments) ---
# Test credentials work: https://www.mercadopago.com.br/developers/panel/app
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Secret from "Webhooks" in the Mercado Pago panel; used to verify webhook signatures.
MP_WEBHOOK_SECRET=
