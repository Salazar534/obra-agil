# Copy to .env (npm run dev does this for you and fills in a database password).

# --- Server ---
PORT=3001
# Where the app opens; used in links sent by email (password reset). Production: https://app.obiagil.com.br
APP_URL=http://localhost:5173
# Public HTTPS address of the API (https://api.obiagil.com.br). Mercado Pago only sends payment webhooks to HTTPS.
# Leave empty in development: the app then polls Mercado Pago for payment status instead.
PUBLIC_URL=

# Cookie domain shared by the app and the API (production: .obiagil.com.br). Leave empty on localhost.
COOKIE_DOMAIN=

# --- Database (PostgreSQL) ---
# LOCAL_DB=1 makes `npm run dev` create and start a private PostgreSQL cluster in .postgres/
# Set LOCAL_DB=0 to use any other PostgreSQL (Docker, Neon, Supabase, RDS...) via DATABASE_URL.
LOCAL_DB=1
DATABASE_URL=postgres://obra:change-me@127.0.0.1:5433/obra_agil

# --- SMS codes (Twilio Verify) ---
# Without these, codes are printed in the API terminal in development and SMS sign-in is off in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Email (SMTP, e.g. smtp://user:password@smtp.resend.com:587) ---
# Without it, password reset links are printed in the API terminal in development.
SMTP_URL=
MAIL_FROM="Obi Ágil <nao-responda@obraagil.com.br>"

# --- Mercado Pago (Pix, cartão, boleto, lotérica e saldo) ---
# Test or production credentials from the Obra Ágil application.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# OAuth: stores connect their own account and receive the rent there. The platform keeps the service fee.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Must match the redirect URL registered on the application. Default: http://localhost:PORT/api/mercadopago/callback
MP_REDIRECT_URL=
# Secret from "Webhooks" in the Mercado Pago panel; used to verify webhook signatures.
MP_WEBHOOK_SECRET=
