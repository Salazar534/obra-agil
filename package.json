{
  "name": "obra-agil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/db.mjs start && concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "mobile": "npm --prefix mobile start",
    "phone": "node scripts/phone.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:psql": "node scripts/db.mjs psql",
    "db:migrate": "node --env-file=.env server/db/migrate.ts",
    "docs": "node --env-file-if-exists=.env scripts/api-docs.ts",
    "test:api": "node scripts/db.mjs create-test && node scripts/api-test.mjs",
    "seed:castanhal": "node scripts/seed-castanhal.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
